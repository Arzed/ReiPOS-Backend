generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Owner {
  id             String         @id @default(uuid())
  name           String
  email          String         @unique
  password       String
  pin            String         @default("123456")
  whatsappNum    String         @unique
  role           String         @default("owner")
  storeId        String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  cashierOrders  Order[]        @relation("OwnerCashierOrders")
  store          Store?         @relation("StoreEmployees", fields: [storeId], references: [id], onDelete: Cascade)
  startingCashes StartingCash[]
  stores         Store[]        @relation("StoreOwner")
}

model Store {
  id             String         @id @default(uuid())
  ownerId        String
  name           String
  location       String?
  target         Float          @default(0.0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  taxActive      Boolean        @default(true)
  taxRate        Float          @default(10.0)
  orders         Order[]
  employees      Owner[]        @relation("StoreEmployees")
  products       Product[]
  startingCashes StartingCash[]
  owner          Owner          @relation("StoreOwner", fields: [ownerId], references: [id], onDelete: Cascade)
}

model Product {
  id         String      @id @default(uuid())
  storeId    String
  name       String
  category   String?
  barcode    String?
  price      Float
  costPrice  Float
  discount   Float       @default(0)
  stock      Int
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  orderItems OrderItem[]
  store      Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, barcode])
}

model Order {
  id            String      @id @default(uuid())
  storeId       String
  totalAmount   Float
  totalProfit   Float
  paymentStatus String
  paymentMethod String
  cashReceived  Float?
  cashChange    Float?
  cashierId     String?
  cashierName   String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  cashier       Owner?      @relation("OwnerCashierOrders", fields: [cashierId], references: [id])
  store         Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  items         OrderItem[]
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  productId String
  quantity  Int
  price     Float
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])
}

model ChatMessage {
  id        String   @id @default(uuid())
  phone     String
  skillId   String?
  role      String
  content   String
  createdAt DateTime @default(now())
}

model StartingCash {
  id            String   @id @default(uuid())
  storeId       String
  amount        Float
  createdById   String
  createdByName String
  date          String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdBy     Owner    @relation(fields: [createdById], references: [id], onDelete: Cascade)
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, date])
}
